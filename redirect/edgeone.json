{
  "installCommand": "true",
  "buildCommand": "mkdir -p out && cp index.html out/index.html",
  "outputDirectory": "out",
  "redirects": [
    {
      "source": "/",
      "destination": "https://takeruf.com",
      "statusCode": 301
    },
    {
      "source": "/*",
      "destination": "https://takeruf.com/:splat",
      "statusCode": 301
    }
  ]
}
